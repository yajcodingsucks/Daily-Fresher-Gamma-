{
  "name": "daily-fresher-invoices",
  "version": "0.1.0",
  "description": "Weekly DF / INV invoices, receipts and monthly statements for Daily Fresher Ltd",
  "main": "main/main.js",
  "author": "Daily Fresher Ltd",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "node scripts/start.js",
    "test": "node --test test/*.test.js",
    "setup:electron": "node scripts/setup-electron.js",
    "predist": "node scripts/setup-electron.js --check && node scripts/clean-dist.js",
    "dist": "electron-builder --win",
    "predist:setup": "node scripts/setup-electron.js --check && node scripts/clean-dist.js",
    "dist:setup": "electron-builder --win nsis --x64 --arm64",
    "predist:portable": "node scripts/setup-electron.js --check && node scripts/clean-dist.js",
    "dist:portable": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "sql.js": "^1.12.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "mu.dailyfresher.invoices",
    "productName": "Daily Fresher Invoices",
    "copyright": "Daily Fresher Ltd",
    "electronDist": "electron-zips",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": true,
    "files": [
      "main/**/*",
      "renderer/**/*",
      "package.json",
      "!node_modules/sql.js/dist/*.zip",
      "!node_modules/sql.js/dist/sql-asm*",
      "!node_modules/sql.js/dist/*debug*",
      "!node_modules/sql.js/dist/*browser*",
      "!node_modules/sql.js/dist/*inline*",
      "!node_modules/sql.js/dist/worker*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Daily Fresher Invoices",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Daily Fresher Invoices Setup.exe",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "Daily Fresher Invoices.exe"
    }
  },
  "allowScripts": {
    "electron@45.4.1": false,
    "electron-winstaller@5.4.0": false
  }
}
