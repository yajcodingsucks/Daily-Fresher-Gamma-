{
  "name": "daily-fresher-invoices",
  "version": "0.1.0",
  "description": "Weekly DF / INV invoices, receipts and monthly statements for Daily Fresher Ltd",
  "main": "main/main.js",
  "author": "Daily Fresher Ltd",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "node scripts/start.js",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win nsis portable --x64",
    "dist:setup": "electron-builder --win nsis --x64",
    "dist:portable": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "sql.js": "^1.12.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "mu.dailyfresher.invoices",
    "productName": "Daily Fresher Invoices",
    "copyright": "Daily Fresher Ltd",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": true,
    "files": [
      "main/**/*",
      "renderer/**/*",
      "package.json",
      "!node_modules/sql.js/dist/*.zip",
      "!node_modules/sql.js/dist/sql-asm*",
      "!node_modules/sql.js/dist/*debug*",
      "!node_modules/sql.js/dist/*browser*",
      "!node_modules/sql.js/dist/*inline*",
      "!node_modules/sql.js/dist/worker*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Daily Fresher Invoices",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Daily Fresher Invoices Setup.exe"
    },
    "portable": {
      "artifactName": "Daily Fresher Invoices.exe"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}